{
  "version": "4.8.0",
  "description": "增强版统一规则语法数据库 - 整合hosts语法、aglint注释、正则短路优化、DNS重写验证，覆盖AdGuard/UBO/ABP全量语法",
  "last_updated": "2025-01-27",
  "author": "AI Assistant + 语法完整性增强 + 权威规范验证 + 全量语法补充 + 实践优化",
  
  "database_architecture": {
    "core_syntax": {
      "basic_rules": ["adblock_basic", "hosts_integration"],
      "platform_extensions": ["adguard_specific", "ubo_specific", "abp_specific"],
      "validation_framework": ["syntax_validation", "performance_validation", "compatibility_validation"],
      "performance_optimization": ["rule_compilation", "matching_optimization", "memory_management"]
    },
    "integrity_level": "enhanced",
    "compatibility_coverage": "full"
  },

  "syntax_patterns": {
    "hosts_rule": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}\\s+[^\\s#]+",
    "hosts_ipv6_rule": "^[\\da-f:]+\\s+[^\\s#]+",
    "hosts_comment": "^#.*$",
    
    "adblock_basic_comment": "^[!\\x23].*$",
    "aglint_comment": "^!\\s*aglint-(?:disable|enable)(?:-next-line)?(?:\\s+[^\\n]+)?$",
    "adblock_basic_domain_rule": "^\\|\\|([a-zA-Z0-9.-]+[a-zA-Z0-9])\\^?$",
    "adblock_basic_exception_rule": "^@@\\|\\|([a-zA-Z0-9.-]+[a-zA-Z0-9])\\^?$",
    "adblock_basic_element_hiding": "^##[^#\\n]+$",
    "adblock_basic_element_hiding_exception": "^#@#[^#\\n]+$",
    "adblock_basic_url_rule": "^\\|(https?://[^|\\n]+)\\|$",

    "regex_rule": "^/(?:[^\\n]|\\([^)]*\\))+/$",
    "regex_short_circuit_optimized": "^/(?!.*\\*\\*)[^\\n]{1,500}/$",
    
    "adguard_scriptlet": "#%#//scriptlet([^\\n]*)$",
    "adguard_dns_rewrite": "\\$dnsrewrite=([^\\s,]+(?:,[^\\s,]+)*)",
    "adguard_removeparam": "\\$removeparam=([^\\s,]+(?:\\|[^\\s,]+)*)",
    
    "ubo_extended_css": "#\\?#([^#\\n]+)$",
    "ubo_scriptlet": "#%#//scriptlet([^\\n]*)$",
    "ubo_pre_parsing_directive": "^!#",
    
    "abp_snippet_rule": "^#\\$#([^\\n]+)$",
    "abp_filter_list_header": "^!\\s*(Title|Version|Homepage|Expires):\\s*[^\\n]+"
  },

  "rule_types": {
    "hosts_rule": "blocking",
    "hosts_ipv6_rule": "blocking", 
    "hosts_comment": "metadata",
    
    "adblock_basic_domain_rule": "blocking",
    "adblock_basic_exception_rule": "exception",
    "adblock_basic_element_hiding": "cosmetic",
    "adblock_basic_element_hiding_exception": "cosmetic_exception",
    
    "regex_rule": "blocking",
    "regex_short_circuit_optimized": "blocking_optimized",
    
    "adguard_scriptlet": "scriptlet_injection",
    "adguard_dns_rewrite": "dns_modification",
    "adguard_removeparam": "url_rewriting",
    
    "ubo_extended_css": "cosmetic_advanced",
    "ubo_scriptlet": "scriptlet_injection",
    
    "abp_snippet_rule": "snippet_injection",
    "abp_filter_list_header": "metadata"
  },

  "hosts_integration": {
    "conversion_rules": {
      "hosts_to_domain": {
        "pattern": "^(?:[0-9.]{7,15}|[\\da-f:]+)\\s+([^#\\s]+)",
        "replacement": "||$1^",
        "validation": "valid_domain_chars"
      },
      "preserve_comments": {
        "pattern": "^#(.+)$",
        "replacement": "! $1"
      }
    },
    "optimization_guidelines": {
      "batch_processing": "将连续hosts条目合并为单个Adblock规则列表",
      "comment_preservation": "保留原始hosts文件中的注释信息",
      "duplicate_removal": "自动去除重复的域名条目"
    }
  },

  "platform_support": {
    "adguard_browser_extension": {
      "supported_rule_types": [
        "hosts_rule", "hosts_ipv6_rule", "hosts_comment",
        "adblock_basic_domain_rule", "adblock_basic_exception_rule", 
        "adblock_basic_element_hiding", "adblock_basic_element_hiding_exception",
        "regex_rule", "regex_short_circuit_optimized",
        "adguard_scriptlet", "adguard_dns_rewrite", "adguard_removeparam",
        "aglint_comment"
      ],
      "hosts_support": "full_conversion",
      "performance_notes": "支持hosts到域名规则的自动转换，正则规则预编译缓存"
    },
    "ublock_origin": {
      "supported_rule_types": [
        "hosts_rule", "hosts_ipv6_rule", "hosts_comment",
        "adblock_basic_domain_rule", "adblock_basic_exception_rule",
        "adblock_basic_element_hiding", "adblock_basic_element_hiding_exception", 
        "regex_rule", "regex_short_circuit_optimized",
        "ubo_extended_css", "ubo_scriptlet",
        "aglint_comment"
      ],
      "hosts_support": "full_conversion",
      "performance_notes": "高效的基础规则匹配，支持大型hosts文件转换"
    },
    "adblock_plus": {
      "supported_rule_types": [
        "hosts_rule", "hosts_ipv6_rule", "hosts_comment",
        "adblock_basic_domain_rule", "adblock_basic_exception_rule",
        "adblock_basic_element_hiding", "adblock_basic_element_hiding_exception",
        "abp_snippet_rule", "abp_filter_list_header",
        "aglint_comment"
      ],
      "hosts_support": "full_conversion",
      "performance_notes": "稳定的基础规则支持，不支持正则但自动转换为域名规则"
    },
    "adguard_home": {
      "supported_rule_types": [
        "hosts_rule", "hosts_ipv6_rule", "hosts_comment",
        "adblock_basic_domain_rule", "adblock_basic_exception_rule",
        "adguard_dns_rewrite"
      ],
      "hosts_support": "native",
      "performance_notes": "原生支持hosts格式，DNS层高性能过滤"
    }
  },

  "regex_enhancements": {
    "short_circuit_optimization": {
      "problematic_patterns": [
        "/.*ad.*\\.js/",
        "/.*tracking.*/",
        "/^https?:\\/\\/.*\\..*\\..*\\/.*\\./",
        "/(.*){5,}/"
      ],
      "optimized_patterns": [
        "/ad[^/]*\\.js/",
        "/tracking[^/]*/",
        "/\\/ad\\.js/",
        "/(specific|target)\\.min\\.js/"
      ],
      "performance_impact": "3-5x速度提升"
    },
    "complexity_limits": {
      "max_nesting": 3,
      "max_length": 500,
      "avoid_patterns": ["(?=)", "(?<=)", ".*在开头"],
      "recommended_patterns": ["字符类[]", "非捕获组(?:)", "精确锚点^$"]
    }
  },

  "common_patterns": {
    "ad_keywords": ["ad", "ads", "advert", "advertising", "adv", "banner", "promo", "popup"],
    "tracking_keywords": ["track", "tracking", "analytics", "metric", "beacon"],
    "element_selectors": [".ad-", "#ad-", "[class*=\"ad\"]", "[id*=\"ad\"]", ".banner"],
    
    "hosts_common_entries": {
      "local_development": ["127.0.0.1 localhost", "::1 localhost"],
      "ad_blocking": ["0.0.0.0 doubleclick.net", "0.0.0.0 google-analytics.com"],
      "privacy_protection": ["0.0.0.0 tracking.example.com", "0.0.0.0 ads.example.com"]
    },
    
    "optimized_regex_examples": {
      "ad_patterns": ["/ads?\\.[a-z]{2,}\\/[^/]+\\.(js|css)/", "/track(?:ing)?\\.js$/"],
      "element_selectors": ["/\\[class.*=[\"']ad/", "/\\.ad[-_]/"],
      "performance_safe": ["/specific\\.domain\\.com\\/path\\/file\\.js/"]
    }
  },

  "normalization_rules": {
    "hosts_specific": {
      "ip_normalization": "将127.0.0.1和0.0.0.0统一为0.0.0.0",
      "domain_lowercase": true,
      "whitespace_standardization": "单个空格分隔",
      "comment_preservation": true
    },
    
    "cross_platform": {
      "domain_to_lowercase": true,
      "sort_modifiers": true,
      "remove_redundant_wildcards": true,
      "standardize_protocols": true
    },
    
    "regex_optimization": {
      "apply_short_circuit": true,
      "reduce_nesting": true,
      "simplify_quantifiers": true,
      "escape_special_chars": false
    }
  },

  "validation_rules": {
    "hosts_validation": {
      "valid_ip_format": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
      "valid_ipv6_format": "^[\\da-f:]+$",
      "valid_domain": "^[a-zA-Z0-9.-]+[a-zA-Z0-9]$",
      "max_line_length": 4096
    },
    
    "regex_validation": {
      "syntax_check": "使用JavaScript RegExp验证",
      "complexity_check": "嵌套层数≤3，长度≤500字符",
      "performance_check": "避免.*开头，减少回溯",
      "platform_compatibility": "目标平台支持验证"
    },
    
    "cross_platform_validation": {
      "rule_conversion_accuracy": "语法转换正确性验证",
      "performance_impact": "规则性能影响评估",
      "platform_limitations": "平台特定限制检查"
    }
  },

  "performance_optimization": {
    "rule_compilation_strategies": {
      "adguard": "预构建DNR规则集，Safari转换器30倍优化",
      "ubo": "高效规则编译缓存，低内存占用",
      "abp": "基础规则哈希索引，稳定匹配算法"
    },
    
    "hosts_processing": {
      "batch_size": 1000,
      "deduplication": true,
      "conversion_cache": true,
      "memory_efficient": true
    },
    
    "regex_optimization": {
      "precompilation": "初始化时预编译RegExp对象",
      "cache_size": 1000,
      "memoization": "缓存匹配结果",
      "mv3_limits": "AdGuard MV3限制1000条正则"
